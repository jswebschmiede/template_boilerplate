{
	"name": "jswebschmiede/template-boilerplate",
	"description": "Joomla template boilerplate with PSR-12 coding standards",
	"type": "joomla-template",
	"license": "MIT",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10"
	},
	"scripts": {
		"php:lint": "phpcs -p -s",
		"php:lint:errors": "phpcs -p -s --runtime-set ignore_warnings_on_exit 1",
		"php:lint:autofix": "phpcbf"
	},
	"config": {
		"sort-packages": true
	}
}
