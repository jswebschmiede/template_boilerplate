# This file is for unifying the coding style for different editors and IDEs
# https://editorconfig.org/

# Joomla follows PSR-12 for PHP (since 4.2)
# https://manual.joomla.org/docs/get-started/codestyle/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.php]
indent_style = space
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2

[*.{js,css,json}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
